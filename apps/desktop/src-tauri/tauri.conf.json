{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TendTo",
  "version": "0.1.0",
  "identifier": "com.tendto.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../web run dev -- --mode desktop",
    "devUrl": "http://localhost:15175",
    "beforeBuildCommand": "npm --prefix ../web run build -- --mode desktop",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true
    },
    "windows": [
      {
        "label": "main",
        "title": "TendTo",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
