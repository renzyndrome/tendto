{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client", "vite-plugin-pwa/client"],

    /* The two build seams. Vite swaps each for its .desktop.ts sibling in `--mode desktop`;
       tsc always checks against the web implementation, and checks the desktop one on its own
       because it also lives under src/. Both pairs are typed against a shared contract
       (PowerSyncPlatform, AiEngine), which is what keeps them from drifting. */
    "baseUrl": ".",
    "paths": {
      "@powersync-platform": ["./src/lib/powersync/platform.web.ts"],
      "@tendto-ai-engine": ["./src/lib/ai/engine.web.ts"]
    }
  },
  "include": ["src"]
}
