{
  "name": "tendto-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "pwa-assets": "pwa-assets-generator",
    "e2e:pwa": "playwright test -c playwright.pwa.config.ts"
  },
  "dependencies": {
    "@blocknote/core": "0.51.4",
    "@blocknote/mantine": "0.51.4",
    "@blocknote/react": "0.51.4",
    "@mantine/core": "^9.4.1",
    "@mantine/hooks": "^9.4.1",
    "@powersync/common": "2.0.0",
    "@powersync/react": "2.0.0",
    "@powersync/tauri-plugin": "0.0.6",
    "@powersync/web": "2.1.0",
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-router": "1.170.17",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-notification": "2.4.0",
    "better-auth": "1.6.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vite-pwa/assets-generator": "1.0.2",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "latest",
    "eslint": "latest",
    "postcss": "latest",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.0",
    "vite": "^7",
    "vite-plugin-pwa": "1.3.0",
    "vite-plugin-top-level-await": "latest",
    "vite-plugin-wasm": "latest"
