# --- Database (dev: docker compose, host port 15432; prod: Supabase) ---
DATABASE_URL=postgresql+asyncpg://tendto:tendto@localhost:15432/tendto

# --- Auth (better-auth service: apps/auth, :13001) ---
AUTH_URL=http://localhost:13001
AUTH_SECRET=dev-only-change-me
AUTH_DATABASE_URL=postgresql://tendto:tendto@localhost:15432/tendto
AUTH_ISSUER=http://localhost:13001
AUTH_JWKS_URL=http://localhost:13001/api/auth/jwks
AUTH_AUDIENCE=tendto
WEB_URL=http://localhost:15173

# --- PowerSync (dev host port 18080) ---
POWERSYNC_URL=http://localhost:18080
# JWT audience/JWKS config lives in infra/powersync/config.yaml for the dev service

# --- AI (daily summary + user-triggered summarize). Empty AI_API_KEY ⇒ offline fallback. ---
AI_BASE_URL=          # OpenAI-compatible base, e.g. https://api.openai.com/v1 or http://localhost:11434/v1 (Ollama)
AI_API_KEY=           # leave empty in dev to use the deterministic no-network fallback
AI_MODEL=gpt-4o-mini

# --- Web (Vite exposes VITE_* only) ---
VITE_API_URL=http://localhost:18000
VITE_POWERSYNC_URL=http://localhost:18080
VITE_AUTH_URL=http://localhost:13001
