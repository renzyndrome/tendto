# --- Database (dev: docker compose; prod: Supabase) ---
DATABASE_URL=postgresql+asyncpg://tendto:tendto@localhost:5432/tendto

# --- Clerk auth ---
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json

# --- PowerSync ---
POWERSYNC_URL=http://localhost:8080
# JWT audience/secret config lives in infra/powersync/config.yaml for the dev service

# --- Web (Vite exposes VITE_* only) ---
VITE_API_URL=http://localhost:8000
VITE_POWERSYNC_URL=http://localhost:8080
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
