# --- Database (dev: docker compose, host port 15432; prod: Supabase) ---
DATABASE_URL=postgresql+asyncpg://tendto:tendto@localhost:15432/tendto

# --- Auth (better-auth service: apps/auth, :13001) ---
AUTH_URL=http://localhost:13001
AUTH_SECRET=dev-only-change-me
AUTH_DATABASE_URL=postgresql://tendto:tendto@localhost:15432/tendto
AUTH_ISSUER=http://localhost:13001
AUTH_JWKS_URL=http://localhost:13001/api/auth/jwks
AUTH_AUDIENCE=tendto
WEB_URL=http://localhost:15173

# --- PowerSync (dev host port 18080) ---
POWERSYNC_URL=http://localhost:18080
# JWT audience/JWKS config lives in infra/powersync/config.yaml for the dev service

# --- Email (workspace invites). Empty EMAIL_API_KEY ⇒ offline fallback: the invite is still
# created and its link still works, it just isn't delivered, and the UI offers "copy link". ---
# e.g. a Resend API key; leave empty in dev
EMAIL_API_KEY=
EMAIL_FROM=TendTo <invites@tendto.app>
EMAIL_BASE_URL=https://api.resend.com
INVITE_TTL_HOURS=168  # how long an invite link stays valid (7 days)

# --- AI (daily summary + recommendations). Engine order: AI_CLI > AI_API_KEY > offline fallback. ---
# "claude" or "codex" — shell out to the installed CLI on your OWN subscription.
AI_CLI=
                      # Dev/self-host only (your process, your plan); a hosted SaaS must use API keys.
                      # The server needs the CLI on PATH (under nvm, `node` too) — start `make dev`
                      # from a shell where `claude -p` works.
# optional --model override for the CLI; empty = the CLI's default
AI_CLI_MODEL=
# OpenAI-compatible base: https://api.openai.com/v1, https://api.anthropic.com/v1, or http://localhost:11434/v1 (Ollama)
AI_BASE_URL=
# leave empty in dev to use the deterministic no-network fallback
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# --- Web (Vite exposes VITE_* only) ---
VITE_API_URL=http://localhost:18000
VITE_POWERSYNC_URL=http://localhost:18080
VITE_AUTH_URL=http://localhost:13001
