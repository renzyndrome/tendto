# Production environment — set these in Dokploy's Environment tab for the Compose service.
# Domains here must match the ones attached in Dokploy (Traefik terminates HTTPS).

POSTGRES_PASSWORD=              # openssl rand -base64 24
AUTH_SECRET=                    # openssl rand -base64 32
AUTH_AUDIENCE=tendto

WEB_URL=https://tendto.example

# EXTRA browser origins allowed to call the API and the auth service, comma-separated.
# WEB_URL and the desktop shell's webview origins (tauri://localhost, http://tauri.localhost)
# are always allowed; this only ever adds to that list. Usually left blank.
WEB_ORIGINS=
API_URL=https://api.tendto.example
AUTH_URL=https://auth.tendto.example
POWERSYNC_URL=https://sync.tendto.example

# AI daily summary — empty AI_API_KEY keeps the offline fallback (no external calls).
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
