# Production environment for tendto.work. Paste into Dokploy's Environment tab for the Compose
# service. The four URLs must match the domains attached in Dokploy's Domains tab.
#
# Comments sit on their own lines on purpose: after an empty value, an inline comment can be
# read as the value itself.

# HEX, not base64. The password is spliced into three connection URLs
# (postgresql://tendto:PASSWORD@db/...), and base64 can emit "/", which ends the URL's host
# part early and breaks all three.
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_AUDIENCE=tendto

# Public URLs. The VITE_* ones are compiled into the web bundle, so changing any of these is a
# REBUILD of the web service, not a restart.
WEB_URL=https://tendto.work
API_URL=https://api.tendto.work
AUTH_URL=https://auth.tendto.work
POWERSYNC_URL=https://sync.tendto.work

# EXTRA browser origins allowed to call the API and the auth service, comma-separated.
# WEB_URL and the desktop shell's webview origins (tauri://localhost, http://tauri.localhost)
# are always allowed; this only ever adds to that list. Usually left blank.
WEB_ORIGINS=

# Server-side AI, for the web and phone apps only. An empty AI_API_KEY means no server engine:
# the recap still shows its facts, the browser shows no AI buttons, and the desktop app runs AI
# on each user's own claude or codex CLI instead. Setting a key later turns web AI on, and is a
# restart rather than a rebuild. The server never runs a CLI in production (AI_CLI is not even
# passed through by docker-compose.prod.yml).
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
